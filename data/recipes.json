[
  {
    "id": "gyudon",
    "title": {
      "en": "Yoshinoya-style beef bowl",
      "zh": "日式吉野家牛肉飯"
    },
    "cuisine": {
      "en": "Japan",
      "zh": "日本"
    },
    "type": {
      "en": "Main",
      "zh": "主菜"
    },
    "baseServings": 3,
    "minutes": 30,
    "added": "2026-11-22",
    "tags": [
      "beef",
      "rice",
      "quick"
    ],
    "image": "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Thinly sliced beef",
          "zh": "薄切肥牛／牛肉片"
        },
        "amount": "475 g"
      },
      {
        "name": {
          "en": "Onion",
          "zh": "洋蔥"
        },
        "amount": "1.5"
      },
      {
        "name": {
          "en": "Japanese or short-grain rice, uncooked",
          "zh": "日本米或珍珠米（生米）"
        },
        "amount": "300 g"
      },
      {
        "name": {
          "en": "Ginger, grated",
          "zh": "薑蓉"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Water",
          "zh": "水"
        },
        "amount": "200 ml"
      },
      {
        "name": {
          "en": "Japanese soy sauce",
          "zh": "日式醬油"
        },
        "amount": "4 tbsp"
      },
      {
        "name": {
          "en": "Mirin",
          "zh": "味醂"
        },
        "amount": "4 tbsp"
      },
      {
        "name": {
          "en": "Sake",
          "zh": "清酒"
        },
        "amount": "3 tbsp"
      },
      {
        "name": {
          "en": "Sugar",
          "zh": "糖"
        },
        "amount": "1.5 tbsp"
      },
      {
        "name": {
          "en": "Instant dashi",
          "zh": "鰹魚粉"
        },
        "amount": "0.5 tsp"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Prepare",
          "zh": "備料"
        },
        "en": "Slice the onion thinly. Cut long beef slices into bite-sized pieces and grate the ginger.",
        "zh": "洋蔥切幼條；牛肉片太長可剪成易入口大小，薑磨成蓉。"
      },
      {
        "title": {
          "en": "Simmer the onion",
          "zh": "煮洋蔥"
        },
        "en": "Combine water, soy sauce, mirin, sake, sugar and dashi in a pan. Add onion and simmer over medium heat for 5–7 minutes until soft.",
        "zh": "將水、醬油、味醂、清酒、糖及鰹魚粉放入鍋中，加入洋蔥，中火煮5–7分鐘至軟。"
      },
      {
        "title": {
          "en": "Cook the beef",
          "zh": "煮牛肉"
        },
        "en": "Stir in ginger. Add beef a few slices at a time so it does not clump. Simmer 3–5 minutes until fully cooked.",
        "zh": "加入薑蓉拌勻，再逐片加入牛肉避免黏成一團；煮3–5分鐘至熟透。"
      },
      {
        "title": {
          "en": "Serve",
          "zh": "上碗"
        },
        "en": "Serve over hot rice with some cooking liquid. Keep the sauce slightly loose so it can soak into the rice.",
        "zh": "牛肉及洋蔥鋪在熱飯上，淋上少量湯汁；醬汁保留少許流動感，方便拌飯。"
      }
    ],
    "notes": {
      "en": "If you do not have sake, replace it with 2 tbsp extra water. Pickled ginger or spring onion makes a good topping.",
      "zh": "沒有清酒可用額外2湯匙水代替。可配紅薑絲或蔥花。"
    }
  },
  {
    "id": "carbonara-guanciale-cheddar",
    "title": {
      "en": "Guanciale & cheddar carbonara",
      "zh": "煙頰肉車打芝士卡邦尼"
    },
    "cuisine": {
      "en": "Italy",
      "zh": "意大利"
    },
    "type": {
      "en": "Pasta",
      "zh": "意粉"
    },
    "baseServings": 3,
    "minutes": 25,
    "added": "2026-11-22",
    "tags": [
      "pasta",
      "guanciale",
      "quick"
    ],
    "image": "https://images.unsplash.com/photo-1473093295043-cdd812d0e601?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Spaghetti",
          "zh": "意粉"
        },
        "amount": "300 g"
      },
      {
        "name": {
          "en": "Guanciale",
          "zh": "煙頰肉"
        },
        "amount": "150 g"
      },
      {
        "name": {
          "en": "Whole eggs",
          "zh": "全蛋"
        },
        "amount": "2"
      },
      {
        "name": {
          "en": "Egg yolks",
          "zh": "蛋黃"
        },
        "amount": "2"
      },
      {
        "name": {
          "en": "Cheddar, finely grated",
          "zh": "車打芝士（幼刨）"
        },
        "amount": "70 g"
      },
      {
        "name": {
          "en": "Double cream, optional",
          "zh": "雙忌廉（可選）"
        },
        "amount": "40 ml"
      },
      {
        "name": {
          "en": "Black pepper",
          "zh": "黑椒"
        },
        "amount": "1 tsp"
      },
      {
        "name": {
          "en": "Salt for pasta water",
          "zh": "煮意粉用鹽"
        },
        "amount": "to taste"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Mix the cheese and eggs",
          "zh": "混合芝士蛋液"
        },
        "en": "Finely grate the cheddar. Whisk with whole eggs, yolks, cream if using, and plenty of black pepper until smooth.",
        "zh": "車打芝士幼刨，與全蛋、蛋黃、可選忌廉及黑椒拌勻至順滑。"
      },
      {
        "title": {
          "en": "Render the guanciale",
          "zh": "煎出煙頰肉油"
        },
        "en": "Put diced guanciale in a cold pan. Cook over medium-low heat for 7–10 minutes until golden and crisp. Keep the rendered fat in the pan.",
        "zh": "煙頰肉切粒，冷鍋下鍋，以中小火煎7–10分鐘至金黃香脆，保留鍋中的油。"
      },
      {
        "title": {
          "en": "Cook the pasta",
          "zh": "煮意粉"
        },
        "en": "Boil spaghetti in salted water until al dente. Reserve about 200 ml pasta water, then drain.",
        "zh": "意粉以鹽水煮至彈牙，留起約200毫升意粉水後瀝乾。"
      },
      {
        "title": {
          "en": "Make the sauce",
          "zh": "拌成醬汁"
        },
        "en": "Turn off the heat. Toss pasta in the guanciale fat, wait 30–45 seconds, then add 2–3 tbsp pasta water. Slowly add the egg mixture while tossing. Loosen gradually with pasta water until glossy.",
        "zh": "熄火後將意粉拌入煙頰肉油，等30–45秒，加入2–3湯匙意粉水。邊拌邊慢慢加入蛋液，再逐少加意粉水至醬汁光亮掛麵。"
      },
      {
        "title": {
          "en": "Finish",
          "zh": "完成"
        },
        "en": "Fold in the crispy guanciale and more black pepper. Taste before adding salt; the meat and cheddar are salty.",
        "zh": "拌入香脆煙頰肉及額外黑椒。先試味才加鹽，煙頰肉和芝士已有鹹味。"
      }
    ],
    "notes": {
      "en": "Keep the pan off the heat when adding eggs so they form a creamy sauce rather than scrambled eggs.",
      "zh": "加入蛋液時必須離火，令蛋液成為忌廉狀醬汁而不是炒蛋。"
    }
  },
  {
    "id": "creamy-mushroom-chicken-rice",
    "title": {
      "en": "Creamy mushroom & guanciale chicken rice",
      "zh": "忌廉蘑菇煙頰肉雞飯"
    },
    "cuisine": {
      "en": "French-inspired",
      "zh": "法式風味"
    },
    "type": {
      "en": "Main",
      "zh": "主菜"
    },
    "baseServings": 3,
    "minutes": 45,
    "added": "2026-11-22",
    "tags": [
      "chicken",
      "mushroom",
      "rice"
    ],
    "image": "https://images.unsplash.com/photo-1604908176997-125f25cc6f3d?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Chicken, half a chicken cut into pieces",
          "zh": "半隻雞（斬件）"
        },
        "amount": "500–700 g"
      },
      {
        "name": {
          "en": "Brown shimeji mushrooms",
          "zh": "啡色鴻喜菇"
        },
        "amount": "150 g"
      },
      {
        "name": {
          "en": "Guanciale",
          "zh": "煙頰肉"
        },
        "amount": "40–60 g"
      },
      {
        "name": {
          "en": "Double cream",
          "zh": "雙忌廉"
        },
        "amount": "250 ml"
      },
      {
        "name": {
          "en": "Chicken stock",
          "zh": "雞湯"
        },
        "amount": "250 ml"
      },
      {
        "name": {
          "en": "Butter",
          "zh": "牛油"
        },
        "amount": "10 g"
      },
      {
        "name": {
          "en": "Onion",
          "zh": "洋蔥"
        },
        "amount": "0.5"
      },
      {
        "name": {
          "en": "Garlic",
          "zh": "蒜頭"
        },
        "amount": "3 cloves"
      },
      {
        "name": {
          "en": "Dijon mustard",
          "zh": "第戎芥末"
        },
        "amount": "1.5 tsp"
      },
      {
        "name": {
          "en": "Thyme",
          "zh": "百里香"
        },
        "amount": "0.5 tsp"
      },
      {
        "name": {
          "en": "Rice, uncooked",
          "zh": "白米（生米）"
        },
        "amount": "270 g"
      },
      {
        "name": {
          "en": "White wine, optional",
          "zh": "白酒（可選）"
        },
        "amount": "50 ml"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Render the guanciale",
          "zh": "煎煙頰肉"
        },
        "en": "Cook guanciale in a pan over medium heat until golden. Lift it out and keep the fat in the pan.",
        "zh": "煙頰肉以中火煎至金黃，先盛起並保留鍋中的油。"
      },
      {
        "title": {
          "en": "Brown the chicken",
          "zh": "煎香雞件"
        },
        "en": "Pat chicken dry, season, and brown in the guanciale fat. Turn to colour the sides, then set aside; it will finish cooking in the sauce.",
        "zh": "雞件印乾並調味，用煙頰肉油煎至表面上色後盛起，稍後在醬汁中煮熟。"
      },
      {
        "title": {
          "en": "Cook the aromatics",
          "zh": "炒香配料"
        },
        "en": "Add butter, onion, garlic and mushrooms. Cook until the onion softens and the mushrooms begin to brown. Add wine if using and scrape up the browned bits.",
        "zh": "鍋中加入牛油、洋蔥、蒜頭和蘑菇，炒至洋蔥軟、蘑菇略為金黃。可加白酒並刮起鍋底焦香。"
      },
      {
        "title": {
          "en": "Simmer the chicken",
          "zh": "燜煮雞件"
        },
        "en": "Add stock and thyme, return chicken, cover and simmer gently until cooked through. Stir in cream and Dijon mustard; simmer uncovered for 5–8 minutes until the sauce lightly thickens.",
        "zh": "加入雞湯和百里香，放回雞件，蓋上鍋蓋以小火煮至熟透。加入忌廉及第戎芥末，開蓋煮5–8分鐘至醬汁略稠。"
      },
      {
        "title": {
          "en": "Finish and serve",
          "zh": "完成上碟"
        },
        "en": "Return guanciale for the final 1–2 minutes. Serve with cooked rice and keep the sauce slightly loose so it can coat the rice.",
        "zh": "最後1–2分鐘放回煙頰肉。配白飯享用，醬汁不要收得太乾，方便拌飯。"
      }
    ],
    "notes": {
      "en": "Taste before salting because guanciale and stock both add salt. Check chicken at the thickest part.",
      "zh": "煙頰肉和雞湯都有鹹味，最後試味才加鹽。雞肉要檢查最厚位置是否熟透。"
    }
  },
  {
    "id": "prawn-caesar-salad",
    "title": {
      "en": "Garlic Caesar-style prawn salad",
      "zh": "蒜香芝士大蝦凱撒沙律"
    },
    "cuisine": {
      "en": "Hong Kong café-style",
      "zh": "港式西餐廳風"
    },
    "type": {
      "en": "Salad",
      "zh": "沙律"
    },
    "baseServings": 3,
    "minutes": 20,
    "added": "2026-11-22",
    "tags": [
      "prawns",
      "salad",
      "quick"
    ],
    "image": "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Peeled prawns",
          "zh": "去殼大蝦"
        },
        "amount": "330 g"
      },
      {
        "name": {
          "en": "Romaine lettuce",
          "zh": "羅馬生菜"
        },
        "amount": "200 g"
      },
      {
        "name": {
          "en": "Cucumber",
          "zh": "青瓜"
        },
        "amount": "100 g"
      },
      {
        "name": {
          "en": "Croutons",
          "zh": "麵包粒"
        },
        "amount": "45 g"
      },
      {
        "name": {
          "en": "Mayonnaise",
          "zh": "蛋黃醬"
        },
        "amount": "5 tbsp"
      },
      {
        "name": {
          "en": "Garlic, minced",
          "zh": "蒜蓉"
        },
        "amount": "1 tsp"
      },
      {
        "name": {
          "en": "Lemon juice",
          "zh": "檸檬汁"
        },
        "amount": "1.5 tbsp"
      },
      {
        "name": {
          "en": "Dijon mustard",
          "zh": "第戎芥末"
        },
        "amount": "1 tsp"
      },
      {
        "name": {
          "en": "Worcestershire sauce",
          "zh": "喼汁"
        },
        "amount": "1 tsp"
      },
      {
        "name": {
          "en": "Parmesan, grated",
          "zh": "巴馬臣芝士（刨碎）"
        },
        "amount": "20 g"
      },
      {
        "name": {
          "en": "Olive oil",
          "zh": "橄欖油"
        },
        "amount": "1 tbsp"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Cook the prawns",
          "zh": "煎熟大蝦"
        },
        "en": "Pat prawns dry and season lightly. Pan-fry over medium heat for about 1–2 minutes per side, until opaque and cooked through. Cool slightly.",
        "zh": "大蝦印乾並輕輕調味，以中火每面煎約1–2分鐘至不透明熟透，稍為放涼。"
      },
      {
        "title": {
          "en": "Mix the dressing",
          "zh": "調沙律醬"
        },
        "en": "Stir mayonnaise, garlic, lemon juice, mustard, Worcestershire sauce, Parmesan and olive oil together. Add a little cold water if needed to loosen.",
        "zh": "蛋黃醬、蒜蓉、檸檬汁、芥末、喼汁、巴馬臣芝士及橄欖油拌勻；太稠可加少量凍水。"
      },
      {
        "title": {
          "en": "Assemble",
          "zh": "組合沙律"
        },
        "en": "Wash and thoroughly dry the lettuce. Toss with cucumber and about half the dressing. Top with prawns and croutons, then finish with the remaining dressing and black pepper.",
        "zh": "生菜洗淨並徹底瀝乾，與青瓜及一半沙律醬拌勻。放上大蝦和麵包粒，再加餘下沙律醬及黑椒。"
      }
    ],
    "notes": {
      "en": "For a less rich dressing, add a little more lemon juice. Parmesan is closer to classic Caesar flavour than cheddar.",
      "zh": "想清爽一點可加少許檸檬汁。巴馬臣芝士比車打芝士更接近經典凱撒醬味道。"
    }
  },
  {
    "id": "tuna-mushroom-pasta",
    "title": {
      "en": "Creamy tuna & mushroom pasta",
      "zh": "忌廉吞拿魚蘑菇意粉"
    },
    "cuisine": {
      "en": "Western",
      "zh": "西式"
    },
    "type": {
      "en": "Pasta",
      "zh": "意粉"
    },
    "baseServings": 3,
    "minutes": 30,
    "added": "2026-11-22",
    "tags": [
      "tuna",
      "mushroom",
      "pasta"
    ],
    "image": "https://images.unsplash.com/photo-1473093295043-cdd812d0e601?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Pasta",
          "zh": "意粉"
        },
        "amount": "285 g"
      },
      {
        "name": {
          "en": "Canned tuna, drained",
          "zh": "罐頭吞拿魚（瀝乾）"
        },
        "amount": "2 cans"
      },
      {
        "name": {
          "en": "Mushrooms",
          "zh": "蘑菇"
        },
        "amount": "200 g"
      },
      {
        "name": {
          "en": "Garlic, minced",
          "zh": "蒜蓉"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Butter",
          "zh": "牛油"
        },
        "amount": "15 g"
      },
      {
        "name": {
          "en": "Olive oil",
          "zh": "橄欖油"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Double cream",
          "zh": "雙忌廉"
        },
        "amount": "100 ml"
      },
      {
        "name": {
          "en": "Mature cheddar, grated",
          "zh": "熟成車打芝士（刨碎）"
        },
        "amount": "25–30 g"
      },
      {
        "name": {
          "en": "Spinach",
          "zh": "菠菜"
        },
        "amount": "50 g"
      },
      {
        "name": {
          "en": "Pasta water",
          "zh": "意粉水"
        },
        "amount": "150–200 ml"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Cook the pasta",
          "zh": "煮意粉"
        },
        "en": "Boil pasta in salted water until al dente. Reserve about 200 ml cooking water, then drain.",
        "zh": "意粉以鹽水煮至彈牙，留起約200毫升意粉水後瀝乾。"
      },
      {
        "title": {
          "en": "Brown the mushrooms",
          "zh": "煎香蘑菇"
        },
        "en": "Slice mushrooms. Heat olive oil and butter in a pan; cook over medium-high heat for 5–7 minutes until golden.",
        "zh": "蘑菇切片。平底鑊加橄欖油及牛油，中大火煎5–7分鐘至金黃。"
      },
      {
        "title": {
          "en": "Make the sauce",
          "zh": "煮白汁"
        },
        "en": "Add garlic and cook for 30 seconds. Stir in cream and 100 ml pasta water; simmer gently for 1–2 minutes. Add cheddar and stir until melted.",
        "zh": "加入蒜蓉炒30秒，加入忌廉及100毫升意粉水，小火煮1–2分鐘。加入車打芝士拌至融化。"
      },
      {
        "title": {
          "en": "Finish",
          "zh": "完成"
        },
        "en": "Fold in drained tuna, pasta and spinach. Add more pasta water a little at a time until the sauce coats the pasta. Season with black pepper.",
        "zh": "拌入瀝乾吞拿魚、意粉及菠菜。逐少加意粉水至醬汁掛麵，最後以黑椒調味。"
      }
    ],
    "notes": {
      "en": "Brown the mushrooms before adding cream. Add tuna near the end to keep it in pieces.",
      "zh": "蘑菇先煎香才加忌廉；吞拿魚最後加入，可保留肉塊口感。"
    }
  },
