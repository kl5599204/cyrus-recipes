    },
    "baseServings": 2,
    "minutes": 35,
    "added": "2026-11-22",
    "tags": [
      "pork",
      "noodles",
      "spicy"
    ],
    "image": "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Minced pork",
          "zh": "豬肉碎"
        },
        "amount": "200 g"
      },
      {
        "name": {
          "en": "Noodles",
          "zh": "麵條"
        },
        "amount": "220 g"
      },
      {
        "name": {
          "en": "Preserved mustard greens",
          "zh": "芽菜碎"
        },
        "amount": "40 g"
      },
      {
        "name": {
          "en": "Spring onions",
          "zh": "蔥花"
        },
        "amount": "2"
      },
      {
        "name": {
          "en": "Garlic, minced",
          "zh": "蒜蓉"
        },
        "amount": "2 cloves"
      },
      {
        "name": {
          "en": "Ginger, grated",
          "zh": "薑蓉"
        },
        "amount": "1 tsp"
      },
      {
        "name": {
          "en": "Chicken stock",
          "zh": "雞湯"
        },
        "amount": "700 ml"
      },
      {
        "name": {
          "en": "Sesame paste",
          "zh": "芝麻醬"
        },
        "amount": "2 tbsp"
      },
      {
        "name": {
          "en": "Soy sauce",
          "zh": "生抽"
        },
        "amount": "2 tbsp"
      },
      {
        "name": {
          "en": "Chinkiang vinegar",
          "zh": "鎮江醋"
        },
        "amount": "2 tsp"
      },
      {
        "name": {
          "en": "Sugar",
          "zh": "糖"
        },
        "amount": "1 tsp"
      },
      {
        "name": {
          "en": "Sichuan chilli oil",
          "zh": "四川辣椒油"
        },
        "amount": "1–2 tbsp"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Cook the pork topping",
          "zh": "炒肉臊"
        },
        "en": "Brown pork in a little oil. Add ginger and garlic; fry until fragrant. Add preserved mustard greens and cook for 2 minutes. Season lightly with soy sauce.",
        "zh": "少油將豬肉碎炒至微金黃，加入薑蓉和蒜蓉炒香，再加入芽菜碎炒2分鐘，以少量生抽調味。"
      },
      {
        "title": {
          "en": "Make the sesame base",
          "zh": "調芝麻醬"
        },
        "en": "Mix sesame paste with soy sauce, vinegar and sugar. Gradually whisk in a little warm stock until smooth.",
        "zh": "芝麻醬與生抽、醋及糖拌勻，逐少加入暖雞湯攪至順滑。"
      },
      {
        "title": {
          "en": "Warm the broth",
          "zh": "煮湯底"
        },
        "en": "Heat the remaining stock. Stir in the sesame mixture and Sichuan pepper if using. Keep at a gentle simmer; do not boil hard.",
        "zh": "加熱餘下雞湯，拌入芝麻醬及可選花椒粉，以微滾方式加熱，不要大火滾煮。"
      },
      {
        "title": {
          "en": "Cook and serve",
          "zh": "煮麵上碗"
        },
        "en": "Cook noodles separately and divide between bowls. Ladle in broth, add pork topping and spring onions. Add chilli oil to taste.",
        "zh": "麵條另鍋煮熟後分入碗中，加入湯底、肉臊及蔥花，按口味加辣椒油。"
      }
    ],
    "notes": {
      "en": "For one spicy and one mild bowl, divide the broth before adding chilli oil.",
      "zh": "想一碗辣、一碗不辣，可先分開湯底，再只在辣味那碗加入辣椒油。"
    }
  },
  {
    "id": "mayak-gyeran",
    "title": {
      "en": "Quick Korean soy-marinated eggs",
      "zh": "快速韓式醬油溏心蛋"
    },
    "cuisine": {
      "en": "Korea",
      "zh": "韓國"
    },
    "type": {
      "en": "Side",
      "zh": "配菜"
    },
    "baseServings": 3,
    "minutes": 45,
    "added": "2026-11-22",
    "tags": [
      "egg",
      "make-ahead",
      "side"
    ],
    "image": "https://images.unsplash.com/photo-1518569656558-1f25e69d93d7?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Eggs",
          "zh": "雞蛋"
        },
        "amount": "6"
      },
      {
        "name": {
          "en": "Soy sauce",
          "zh": "生抽"
        },
        "amount": "100 ml"
      },
      {
        "name": {
          "en": "Water",
          "zh": "水"
        },
        "amount": "100 ml"
      },
      {
        "name": {
          "en": "Sugar or honey",
          "zh": "糖或蜜糖"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Rice vinegar",
          "zh": "米醋"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Sesame oil",
          "zh": "麻油"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Garlic, minced",
          "zh": "蒜蓉"
        },
        "amount": "2 cloves"
      },
      {
        "name": {
          "en": "Spring onions, chopped",
          "zh": "蔥花"
        },
        "amount": "2"
      },
      {
        "name": {
          "en": "Sesame seeds",
          "zh": "白芝麻"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Chilli, optional",
          "zh": "辣椒（可選）"
        },
        "amount": "2"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Boil and peel the eggs",
          "zh": "煮蛋及剝殼"
        },
        "en": "Lower eggs into boiling water and cook for 6–7 minutes for jammy yolks. Transfer to ice-cold water, cool, then peel carefully.",
        "zh": "雞蛋放入滾水煮6–7分鐘做溏心蛋，立即放入冰水降溫，冷卻後小心剝殼。"
      },
      {
        "title": {
          "en": "Make the marinade",
          "zh": "調醃汁"
        },
        "en": "Warm soy sauce, water and sugar until the sugar dissolves. Remove from heat; stir in vinegar, sesame oil, garlic, spring onion, sesame seeds and optional chilli.",
        "zh": "生抽、水及糖加熱至糖溶化後離火，拌入醋、麻油、蒜蓉、蔥花、芝麻及可選辣椒。"
      },
      {
        "title": {
          "en": "Marinate",
          "zh": "浸醃"
        },
        "en": "Place peeled eggs in a container and pour over the warm, not boiling, marinade. Chill for at least 30–40 minutes, turning once or twice.",
        "zh": "剝殼蛋放入盒中，倒入暖而非滾燙的醃汁，冷藏至少30–40分鐘，中途翻動一至兩次。"
      },
      {
        "title": {
          "en": "Serve",
          "zh": "享用"
        },
        "en": "Halve the eggs and spoon some marinade over. Serve with rice or noodles.",
        "zh": "雞蛋切半，淋上少量醃汁，配飯或麵享用。"
      }
    ],
    "notes": {
      "en": "Keep marinating eggs refrigerated. For runny eggs, follow UK advice for egg assurance marks and vulnerable groups.",
      "zh": "醃蛋須放雪櫃保存。食用溏心蛋時，請留意英國對蛋品認證及高風險人士的建議。"
    }
  },
  {
    "id": "burger-steak",
    "title": {
      "en": "Saucy burger steak",
      "zh": "多汁漢堡扒"
    },
    "cuisine": {
      "en": "Western",
      "zh": "西式"
    },
    "type": {
      "en": "Main",
      "zh": "主菜"
    },
    "baseServings": 3,
    "minutes": 35,
    "added": "2026-11-22",
    "tags": [
      "beef",
      "comfort food",
      "rice"
    ],
    "image": "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1200&q=82",
    "ingredients": [
      {
        "name": {
          "en": "Beef mince",
          "zh": "牛肉碎"
        },
        "amount": "450 g"
      },
      {
        "name": {
          "en": "Onion, finely diced",
          "zh": "洋蔥（切碎）"
        },
        "amount": "0.5"
      },
      {
        "name": {
          "en": "Egg",
          "zh": "雞蛋"
        },
        "amount": "1"
      },
      {
        "name": {
          "en": "Breadcrumbs",
          "zh": "麵包糠"
        },
        "amount": "30 g"
      },
      {
        "name": {
          "en": "Milk",
          "zh": "牛奶"
        },
        "amount": "2 tbsp"
      },
      {
        "name": {
          "en": "Ketchup",
          "zh": "茄汁"
        },
        "amount": "2 tbsp"
      },
      {
        "name": {
          "en": "Worcestershire sauce",
          "zh": "喼汁"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Beef stock",
          "zh": "牛肉湯"
        },
        "amount": "200 ml"
      },
      {
        "name": {
          "en": "Cornflour",
          "zh": "粟粉"
        },
        "amount": "1 tsp"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Mix and shape",
          "zh": "拌餡及造型"
        },
        "en": "Soften the onion in a little oil and cool. Mix beef, onion, egg, breadcrumbs, milk, salt and pepper gently. Shape into three oval patties; press out air pockets.",
        "zh": "少油炒軟洋蔥並放涼。牛肉碎、洋蔥、雞蛋、麵包糠、牛奶、鹽及黑椒輕輕拌勻，分成三份橢圓形漢堡扒並壓走空氣。"
      },
      {
        "title": {
          "en": "Brown the patties",
          "zh": "煎香漢堡扒"
        },
        "en": "Heat a lightly oiled pan over medium heat. Brown patties for 3–4 minutes per side, then lower heat and cook through. Set aside to rest.",
        "zh": "平底鑊加少量油以中火煎漢堡扒，每面3–4分鐘上色，再轉小火煮至熟透，盛起稍作休息。"
      },
      {
        "title": {
          "en": "Make the sauce",
          "zh": "煮醬汁"
        },
        "en": "Add ketchup, Worcestershire sauce and stock to the pan. Simmer and scrape up browned bits. Stir cornflour with cold water, then add gradually until glossy and thickened.",
        "zh": "鍋中加入茄汁、喼汁及牛肉湯，煮滾並刮起鍋底焦香。粟粉加凍水拌勻，逐少加入煮至醬汁光亮濃稠。"
      },
      {
        "title": {
          "en": "Finish",
          "zh": "完成"
        },
        "en": "Return patties to the sauce briefly to coat. Serve with rice or mashed potato.",
        "zh": "漢堡扒放回醬汁中略煮並裹上醬汁，配飯或薯蓉享用。"
      }
    ],
    "notes": {
      "en": "For home food safety, cook minced-meat patties thoroughly; do not serve burgers pink.",
      "zh": "家中烹調肉碎漢堡扒須徹底煮熟，不應以粉紅色或半生狀態上桌。"
    }
  },
  {
    "id": "creamy-chicken-braise",
