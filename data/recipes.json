      },
      {
        "name": {
          "en": "Leek, sliced",
          "zh": "韭蔥（切片）"
        },
        "amount": "190 g"
      },
      {
        "name": {
          "en": "Garlic, minced",
          "zh": "蒜蓉"
        },
        "amount": "2 cloves"
      },
      {
        "name": {
          "en": "Butter",
          "zh": "牛油"
        },
        "amount": "30 g"
      },
      {
        "name": {
          "en": "Olive oil",
          "zh": "橄欖油"
        },
        "amount": "1 tbsp"
      },
      {
        "name": {
          "en": "Chicken or vegetable stock",
          "zh": "雞湯或蔬菜湯"
        },
        "amount": "700 ml"
      },
      {
        "name": {
          "en": "Double cream",
          "zh": "雙忌廉"
        },
        "amount": "125 ml"
      },
      {
        "name": {
          "en": "Dried thyme",
          "zh": "乾百里香"
        },
        "amount": "0.5 tsp"
      }
    ],
    "steps": [
      {
        "title": {
          "en": "Brown the mushrooms",
          "zh": "煎香蘑菇"
        },
        "en": "Heat oil and half the butter. Cook mushrooms in batches over medium-high heat until deeply golden, 8–12 minutes. Reserve a handful for garnish.",
        "zh": "加熱橄欖油及一半牛油，分批以中大火煎蘑菇8–12分鐘至深金黃色，留起少量作裝飾。"
      },
      {
        "title": {
          "en": "Soften the leek",
          "zh": "炒軟韭蔥"
        },
        "en": "Add remaining butter and leek; cook 5–6 minutes until soft. Add garlic and thyme and cook for 30 seconds.",
        "zh": "加入餘下牛油及韭蔥，炒5–6分鐘至軟。加入蒜蓉和百里香再炒30秒。"
      },
      {
        "title": {
          "en": "Simmer",
          "zh": "煮至軟腍"
        },
        "en": "Add potatoes, mushrooms and stock. Bring to a boil, then simmer for 15–20 minutes until the potatoes are tender.",
        "zh": "加入薯仔、蘑菇及湯底，煮滾後轉小火煮15–20分鐘至薯仔軟腍。"
      },
      {
        "title": {
          "en": "Blend and finish",
          "zh": "打滑並完成"
        },
        "en": "Blend until smooth. Stir in cream over low heat; season with salt and black pepper. Add hot stock or water if the soup is too thick.",
        "zh": "將湯打至滑身，以小火拌入忌廉，再用鹽和黑椒調味。太稠可加熱湯或水調整。"
      }
    ],
    "notes": {
      "en": "Reserve a few browned mushrooms for topping. Blend hot liquids carefully in batches.",
      "zh": "留起少量煎香蘑菇作配料。用攪拌機處理熱湯時要分批並小心防止濺出。"
    }
  },
  {
    "id": "dan-dan-soup-noodles",
    "title": {
      "en": "Sichuan-style sesame soup dan dan noodles",
      "zh": "四川麻醬湯擔擔麵"
    },
    "cuisine": {
      "en": "Sichuan",
      "zh": "四川"
    },
    "type": {
      "en": "Noodles",
